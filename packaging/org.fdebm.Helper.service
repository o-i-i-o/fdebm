[Unit]
Description=Fdebm privileged helper
After=dbus.service polkit.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.fdebm.Helper
ExecStart=/usr/lib/fdebm/fdebm-helperd
User=root
# 指定 User= 后 systemd 会回收 CAP_SETUID；apt 需要它把 http 等方法降权到 _apt，
# 否则 apt update 会报 "seteuid 42 failed (Operation not permitted)"。
AmbientCapabilities=CAP_SETUID
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
