[Unit]
Description=Fdebm privileged helper
After=dbus.service polkit.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.fdebm.Helper
ExecStart=/usr/lib/fdebm/fdebm-helperd
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
